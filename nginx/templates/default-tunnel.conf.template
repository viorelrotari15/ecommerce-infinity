# Cloudflare Tunnel: HTTP on 80 only (no HTTPS redirect).
# Tunnel terminates SSL at Cloudflare; traffic to nginx is HTTP.
# Use Docker's embedded DNS so hostnames are re-resolved when containers are recreated.
server {
    listen 80;
    server_name _;
    resolver 127.0.0.11 valid=10s ipv6=off;

    client_max_body_size 20m;

    location /nginx_status {
        stub_status;
        access_log off;
        allow 0.0.0.0/0;
    }

    location /api/ {
        set $backend_upstream backend:3001;
        proxy_pass http://$backend_upstream/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location / {
        set $frontend_upstream frontend:3000;
        proxy_pass http://$frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
