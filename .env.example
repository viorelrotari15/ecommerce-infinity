POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecommerce
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ecommerce
JWT_SECRET=local-dev-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=products
MINIO_ENDPOINT=minio
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PUBLIC_URL=http://localhost:9000
BACKEND_PORT=3000
FRONTEND_PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_CDN_URL=http://localhost:9000

# Set to your domain for prod; localhost or leave as-is for tunnel
NGINX_SERVER_NAME=localhost

# Optional: expose Grafana at https://YOUR_URL/grafana/ (set both when using public URL)
# GRAFANA_ROOT_URL=https://your-tunnel.trycloudflare.com/grafana
# GRAFANA_SERVE_FROM_SUB_PATH=true
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=change-me

# App-wide currency (prices, Stripe, emails). Use ISO 4217 code (EUR, USD, etc.)
NEXT_PUBLIC_DEFAULT_CURRENCY=EUR
APP_CURRENCY=EUR
STRIPE_CURRENCY=EUR

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_change_me
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me

# Resend (default email provider). Get API key at https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Mistico
ADMIN_ORDER_EMAIL=admin@yourdomain.com

# Branding for emails: theme and logo come from apps/backend/src/config/branding.json (keep in sync with frontend branding).
# Optional overrides via env:
# BRAND_NAME=Ecommerce Infinity
# BRAND_LOGO_URL=https://example.com/logo.png
# BRAND_PRIMARY_COLOR=#111827
# BRAND_WEBSITE=https://example.com
# BRAND_SUPPORT_EMAIL=support@yourdomain.com
# FRONTEND_URL is used to build logo URL from branding.json (e.g. FRONTEND_URL + /branding/logo.svg)
